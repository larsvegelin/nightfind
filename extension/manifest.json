{
  "manifest_version": 3,
  "name": "ParseLab — ParseForm & ParseScraper",
  "version": "1.48.0",
  "description": "Neem je taak op, laat hem nadoen of bouw hem stap voor stap — formulieren invullen, websites uitlezen en PDF's opslaan, met logboek en schermafbeelding per stap. In je eigen browser.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "debugger",
    "webNavigation",
    "alarms"
  ],
  "action": {
    "default_title": "ParseLab — klik om te openen",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "ParseLab-paneel aan/uit"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.parselab.nl/*",
        "https://larsvegelin.github.io/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}